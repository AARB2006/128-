
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ytmp3_beta
DB_USER=root
DB_PASSWORD=

MAX_VIDEO_SECONDS=1800
JS_RUNTIME=node

# Copy this file to .env.local (git-ignored) and fill in the values.
