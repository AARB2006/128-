# Copy this file to backend/.env (git-ignored) and fill in the values.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Public key (same value as VITE_SUPABASE_PUBLISHABLE_KEY). Used only to check
# that a user's login token is valid.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SECRET key from Supabase Dashboard > Settings > API Keys. It bypasses
# row-level security. NEVER commit it, never put it in a VITE_ variable, and
# never paste it into chat.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# --- App limits -------------------------------------------------------------
MAX_VIDEO_SECONDS=1800
DAILY_IMPORT_LIMIT=100
JS_RUNTIME=node

# Browser origins allowed to call this API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173