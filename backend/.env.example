# Copy this file to backend/.env (git-ignored) and fill in the values.
# On Windows, Setup YT-MP3.bat writes backend/.env for you.

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# Public key (same value as VITE_SUPABASE_PUBLISHABLE_KEY). Safe to share:
# row-level security and the database functions protect the data.
# The backend needs NO secret key; never add one here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- App limits -------------------------------------------------------------
# The daily import limit, the songs-per-export limit and the daily export
# limit are kept in the database (private.app_limits), the same for everyone.
MAX_VIDEO_SECONDS=1800
JS_RUNTIME=node

# Browser origins allowed to call this API (comma-separated).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Export -----------------------------------------------------------------
# Exports running at once on this computer.
MAX_CONCURRENT_EXPORTS=2
# Minutes a finished ZIP stays downloadable before it is deleted.
EXPORT_FILE_TTL_MINUTES=60
# Free disk space (MB) to keep in reserve.
EXPORT_MIN_FREE_MB=1024
# Optional: folder for temporary audio and ZIPs (defaults to the system temp folder).
# EXPORT_DIR=
